generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  OWNER
}

enum WashBoxStatus {
  AVAILABLE
  BUSY
  MAINTENANCE
}

enum BookingStatus {
  NEW
  CONFIRMED
  IN_PROGRESS
  DONE
  CANCELLED
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
}

model Client {
  id        String    @id @default(cuid())
  name      String
  phone     String
  createdAt DateTime  @default(now())
  vehicles  Vehicle[]
  bookings  Booking[]
}

model Vehicle {
  id          String    @id @default(cuid())
  clientId    String
  brand       String
  model       String
  plateNumber String    @unique
  client      Client    @relation(fields: [clientId], references: [id])
  bookings    Booking[]
}

model Service {
  id              String         @id @default(cuid())
  name            String
  durationMinutes Int
  price           Float
  orderServices   OrderService[]
}

model WashBox {
  id       String    @id @default(cuid())
  name     String
  status   WashBoxStatus @default(AVAILABLE)
  bookings Booking[]
}

model Booking {
  id        String        @id @default(cuid())
  clientId  String
  vehicleId String
  boxId     String
  startTime DateTime
  endTime   DateTime
  status    BookingStatus @default(NEW)
  client    Client        @relation(fields: [clientId], references: [id])
  vehicle   Vehicle       @relation(fields: [vehicleId], references: [id])
  box       WashBox       @relation(fields: [boxId], references: [id])
  orders    Order[]
}

model Order {
  id            String         @id @default(cuid())
  bookingId     String
  actualStart   DateTime?
  actualEnd     DateTime?
  totalPrice    Float          @default(0)
  status        OrderStatus    @default(PENDING)
  createdAt     DateTime       @default(now())
  booking       Booking        @relation(fields: [bookingId], references: [id])
  orderServices OrderService[]
}

model OrderService {
  id        String  @id @default(cuid())
  orderId   String
  serviceId String
  price     Float
  order     Order   @relation(fields: [orderId], references: [id])
  service   Service @relation(fields: [serviceId], references: [id])
}
